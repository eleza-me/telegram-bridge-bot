# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (e.g. from @userinfobot). The bot answers nobody else.
TELEGRAM_OWNER_ID=
# 32 random bytes, base64: openssl rand -base64 32
# Encrypts the state file (it holds your Eleza session). Keep it secret; losing it means /login again.
BRIDGE_SECRET_KEY=

# --- optional ---
# ELEZA_API_URL=https://api.eleza.me
# BRIDGE_DEFAULT_TARGET=ask        # ask | eli | saved | both (also /mode in the bot)
# BRIDGE_FORWARD_SOURCE=true       # add "↪️ from …" to forwarded content
# BRIDGE_DEVICE_NAME=Telegram bridge
# BRIDGE_POLL_DURATION=24h         # Eli polls: 1h | 24h | 72h | 168h
# BRIDGE_ALBUM_WAIT=1500ms         # how long to wait for the rest of an album
# TELEGRAM_API_URL=https://api.telegram.org
# TELEGRAM_LOCAL_MODE=false        # true with a self-hosted Bot API server started with --local
# ELI_MAX_TEXT_CHARS=500           # server limits (only lower them)
